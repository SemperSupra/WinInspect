; Minimal experimental KMDF VHF source-device package for WinInspect qualification.
; Disposable test fixture, not a product driver package.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=09/17/2026,0.0.0.2
CatalogFile=WinInspectVhfProbe.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NT$ARCH$.10.0...22000

[Models.NT$ARCH$.10.0...22000]
%DeviceName%=DeviceInstall,ROOT\WININSPECT\VHFPROBE

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
WinInspectVhfProbe.sys=1

[DriverCopy]
WinInspectVhfProbe.sys

[DeviceInstall.NT]
CopyFiles=DriverCopy

[DeviceInstall.NT.HW]
AddReg=VhfAddReg

[VhfAddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[DeviceInstall.NT.Services]
AddService=WinInspectVhfProbe,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WinInspectVhfProbe.sys

[DeviceInstall.NT.Wdf]
KmdfService=WinInspectVhfProbe,KmdfInstall

[KmdfInstall]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="WinInspect Experimental Fixture"
DeviceName="WinInspect KMDF VHF Probe Source Device"
ServiceName="WinInspect KMDF VHF Probe"
DiskName="WinInspect VHF Probe Installation Disk"
