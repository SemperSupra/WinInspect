{
  "name": "wininspect",
  "version": "0.4.0",
  "description": "TypeScript SDK for WinInspect daemon — inspect and control Windows desktops programmatically",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wininspect",
    "windows",
    "desktop-automation",
    "wine"
  ],
  "license": "PolyForm-NC-1.0.0",
  "author": "Mark E. DeYoung",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
