# SPDX-License-Identifier: Apache-2.0
# Auto-detect text vs binary; normalize to repo-native (LF) for text
* text=auto

# Shell scripts MUST have LF line endings — CRLF breaks shellcheck and bash on Linux
*.sh text eol=lf

# Go source — LF line endings (go fmt requires LF)
*.go text eol=lf

# YAML/JSON — LF line endings
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# C++ source — LF line endings (matches clang-format expectations)
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Markdown/documentation
*.md text eol=lf

# Binary files — do not touch
*.exe binary
*.dll binary
*.pdb binary
*.jar binary
*.png binary
*.jpg binary
*.ico binary
